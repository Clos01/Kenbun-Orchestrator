#!/usr/bin/env bash
# ==============================================================================
# 🩺 KENBUN-DIAGNOSE: Code Fault & Architecture Diagnostician
# Powered by Qwen 2.5 Coder 14B on LG 2025 LM Studio
# ==============================================================================
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "${DIR}/venv/bin/python" ]; then
    PYTHON_BIN="${DIR}/venv/bin/python"
elif [ -f "${DIR}/.venv/bin/python" ]; then
    PYTHON_BIN="${DIR}/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    PYTHON_BIN="python"
fi

if [ -z "$1" ]; then
    echo -e "\033[1m\033[36m🩺 KENBUN-DIAGNOSE — Code Diagnostician & Surgeon\033[0m"
    echo -e "Usage:"
    echo -e "  bin/kenbun-diagnose \"<issue_or_symptom>\" [target_file]"
    echo -e "Example:"
    echo -e "  bin/kenbun-diagnose \"Why is the async worker hanging on shutdown?\" core/tools/utils/bayesian.py"
    exit 0
fi

export PYTHONPATH="${DIR}:${DIR}/core:${PYTHONPATH:-}"
export PROJECT_ROOT="${DIR}"

exec "$PYTHON_BIN" -c "
import sys
import json
from tools.specialists.pit_crew import consult_code_diagnostician

issue = sys.argv[1]
target_file = sys.argv[2] if len(sys.argv) > 2 else None

res = json.loads(consult_code_diagnostician(issue=issue, target_file=target_file))

print(f'\033[1m\033[32m🩺 [CODE DIAGNOSIS REPORT]\033[0m Engine: {res.get(\"engine\")} | Status: {res.get(\"status\")}')
print('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
print(res.get('diagnosis'))
print('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
" "$@"
