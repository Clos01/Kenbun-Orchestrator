}

def analyze_file(filepath):
    if not os.path.exists(filepath):
        return None
    with open(filepath, "r", encoding="utf-8") as f:
        code = f.read()

    filename = os.path.basename(filepath)
    is_ui = bool(re.search(r'import.*React|useState|<div|export default function', code))
    is_api = bool(re.search(r'APIRouter|@app\.|FastAPI|NextRequest|NextResponse', code))
    is_scanner = bool(re.search(r'arcgis|scrape|fetch.*permit|requests\.get|BeautifulSoup', code))

    if is_scanner:
        return {
            "title": f"Data Harvester: {filename}",
            "metaphor": "This file is like a digital scout with a badge. It logs into public city databases, asks for the newest construction permits, filters out irrelevant projects, and converts the raw data into clean lead cards.",
            "box1": "Raw Public Government Records (JSON / REST API)",
            "box2": f"{filename} (Parsing addresses, dates, contractor names, and flooring tags)",
            "box3": "Central Database / Lead Queue (Ready for sales team review)",
            "elevator": [
                f"This file ({filename}) connects to public municipal databases to extract raw permit filings.",
                "It cleans messy government data into structured contractor and homeowner leads.",
                "It deduplicates existing records so our database never gets bloated with duplicates."
            ],
            "freeze_point": "If someone asks: 'What happens if the city website is down or slow?'\nAnswer: 'The scraper uses defensive timeout wrappers and error handlers so it logs the issue cleanly and retries later without crashing the rest of the system.'"
        }
    elif is_api:
        return {
            "title": f"API Gateway / Backend Router: {filename}",
            "metaphor": "This file is like the head waiter at a high-end restaurant. Customers (the frontend UI) ask for menus and food, and the waiter takes the order, checks with the kitchen (the database), and brings back exactly what was requested on a clean plate.",
            "box1": "Frontend HTTP Requests (Filter by city, date range, or status)",
            "box2": f"{filename} (Authenticates user, validates request parameters, queries SQL)",
            "box3": "JSON Response Envelope (Delivers clean data to the browser in under 200ms)",
            "elevator": [
                f"This file ({filename}) acts as our secure bridge between the user interface and our database.",
                "It validates incoming queries, checks permissions, and runs optimized SQL statements.",
                "It formats the output into clean JSON so the frontend can render without lag."
            ],
            "freeze_point": "If someone asks: 'Why don't we let the frontend talk directly to the database?'\nAnswer: 'Security and speed. Direct database access exposes credentials and crashes under heavy loads; the API validates every request and protects our database.'"
        }
    elif is_ui:
        return {
            "title": f"User Interface Component: {filename}",
            "metaphor": "This file is like the dashboard of an aircraft. Pilots don't look at the jet fuel combustion chambers directly; they look at gauges, dials, and interactive buttons. This component translates raw computer numbers into intuitive visual cards and controls.",
            "box1": "User Clicks & Gestures (Selecting a city, toggling a filter, zooming a map)",
            "box2": f"{filename} (React State Management & Framer Motion animations)",
            "box3": "Rendered Visual Screen (Responsive layout for mobile, laptop, and 4K displays)",
            "elevator": [
                f"This component ({filename}) is responsible for the interactive user experience on screen.",
                "It handles local user state, smooth animations, and zero-layout-shift rendering.",
                "When a user interacts with a control, it dispatches fast updates to sync the view."
            ],
            "freeze_point": "If someone asks: 'How does this look on mobile or small screens?'\nAnswer: 'It adheres to our Responsive UI protocol—it scales proportionally, wraps cleanly, and never causes horizontal scrolling or truncated text.'"
        }
    else:
        return {
            "title": f"System Logic Module: {filename}",
            "metaphor": "This file is an engine gear. It doesn't interact with the outside world directly; it provides specialized math, formatting, or validation to keep the machine running smoothly.",
            "box1": "Raw Inputs from caller modules",
            "box2": f"{filename} (Core transformation logic)",
            "box3": "Deterministic output returned to caller",
            "elevator": [
                f"This file ({filename}) contains modular business logic separated from the UI and network layers.",
                "Keeping this logic isolated makes our code testable, maintainable, and bug-resistant."
            ],
            "freeze_point": "If someone asks: 'Why is this in a separate file?'\nAnswer: 'Single Responsibility Principle—it does one job with high precision and zero side-effects.'"
        }

def print_explanation(data):
    print(f"\n{BOLD}{CYAN}════════════════════════════════════════════════════════════════════════════════════{RESET}")
    print(f"  🧠 {BOLD}KENBUN COGNITIVE DECOMPRESSOR: {data['title']}{RESET}")
    print(f"  {YELLOW}The 'Never Go Blank Again' Accelerated Learning Framework{RESET}")
    print(f"{BOLD}{CYAN}════════════════════════════════════════════════════════════════════════════════════{RESET}\n")

    print(f"🧒 {BOLD}1. THE 10-YEAR-OLD METAPHOR (Zero Jargon / How to Imagine It):{RESET}")
    print(f"   {data['metaphor']}\n")

    print(f"📦 {BOLD}2. THE 3-BOX MECHANICAL SKELETON (Visual Flow):{RESET}")
    print(f"   {GREEN}[ 1. INPUT / SOURCE ]{RESET}  -->  {data['box1']}")
    print(f"             │")
    print(f"             ▼")
    print(f"   {BLUE}[ 2. ENGINE / LOGIC ]{RESET}  -->  {data['box2']}")
    print(f"             │")
    print(f"             ▼")
    print(f"   {MAGENTA}[ 3. VAULT / SCREEN ]{RESET}  -->  {data['box3']}\n")

    print(f"🗣️  {BOLD}3. THE 30-SECOND ELEVATOR DEFENSE (What to Say Out Loud When Asked):{RESET}")
    for i, bullet in enumerate(data['elevator'], 1):
        print(f"   {BOLD}{i}.{RESET} \"{bullet}\"")
    print()

    print(f"🎯 {BOLD}4. THE FREEZE-POINT DRILL (Your Safety Net):{RESET}")
    print(f"   {YELLOW}{data['freeze_point']}{RESET}\n")

    print(f"{BOLD}{CYAN}════════════════════════════════════════════════════════════════════════════════════{RESET}")
    print(f"  💡 {BOLD}Memory Tip:{RESET} Don't try to memorize code. Just remember the 3 boxes: {GREEN}Input{RESET} -> {BLUE}Engine{RESET} -> {MAGENTA}Vault{RESET}.")
    print(f"{BOLD}{CYAN}════════════════════════════════════════════════════════════════════════════════════{RESET}\n")

def main():
    if len(sys.argv) < 2:
        print(f"{BOLD}Usage:{RESET}")
        print("  bin/kenbun-explain <keyword>     (e.g., flooring, Edge_Node, dynamic, hivemind)")
        print("  bin/kenbun-explain <filepath>    (e.g., bin/kenbun-explain src/components/DashboardBody.tsx)")
        print("\nAvailable concepts: " + ", ".join(KNOWLEDGE_BASE.keys()))
        sys.exit(0)

    arg = sys.argv[1].strip().lower()

    if arg in KNOWLEDGE_BASE:
        print_explanation(KNOWLEDGE_BASE[arg])
        return

    if os.path.exists(sys.argv[1]):
        data = analyze_file(sys.argv[1])
        if data:
            print_explanation(data)
            return

    for key, data in KNOWLEDGE_BASE.items():
        if key in arg or arg in key:
            print_explanation(data)
            return

    print(f"\n{RED}Concept or file '{sys.argv[1]}' not found.{RESET}")
    print(f"Try one of: {', '.join(KNOWLEDGE_BASE.keys())} or pass an existing file path.")

if __name__ == "__main__":
    main()
