#!/usr/bin/env python3
"""
Kenbun Cognitive Explainer (Feynman Reversible Decompressor)
Translates complex software features, files, and architectures into:
1. The 10-Year-Old Physical Metaphor (Zero Jargon)
2. The 3-Box Mechanical Flow (Input -> Engine -> Vault/Screen)
3. The 30-Second Elevator Defense (Verbatim script to speak out loud)
4. The Freeze-Point Self-Test (1-question active recall drill)
"""

import sys
import os
import re

BOLD = "\033[1m"
GREEN = "\033[32m"
BLUE = "\033[34m"
YELLOW = "\033[33m"
CYAN = "\033[36m"
RED = "\033[31m"
MAGENTA = "\033[35m"
RESET = "\033[0m"

KNOWLEDGE_BASE = {
    "flooring": {
        "title": "Flooring Contractor Permit Radar (Lead Pipeline)",
        "metaphor": "Imagine 9 different town halls where people submit paperwork to redo their floors. Instead of hiring someone to drive to each town hall every morning, our software sends an automated mail carrier to read the public records, grab all the flooring projects, and pin them on a live radar map for our sales team.",
        "box1": "Public Town Hall Open Data (ArcGIS APIs for Municipal Open Data Portals)",
        "box2": "Python Ingestion Engine (Extracts homeowner address, square footage, valuation, contractor)",
        "box3": "PostgreSQL Vault & Live Interactive Map (6,000+ pins with dynamic town dropdown)",
        "elevator": [
            "We pull public building permits from city databases across North Carolina every night.",
            "Our engine filters out irrelevant projects and only keeps high-value flooring and renovation jobs.",
            "The leads appear instantly on an interactive map, giving our estimators first-mover advantage before competitors even know the job exists."
        ],
        "freeze_point": "If someone asks: 'How does the map know what cities are available?'\nAnswer: 'The map never guesses or hardcodes cities. It queries the database for which towns have leads right now, and builds the dropdown dynamically.'"
    },
    "Edge_Node": {
