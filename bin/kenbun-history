#!/usr/bin/env bash
# ==============================================================================
# 📜 KENBUN-HISTORY: Post-Mortem & Architecture Memory Search
# ==============================================================================
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "${DIR}/venv/bin/python" ]; then
    PYTHON_BIN="${DIR}/venv/bin/python"
elif [ -f "${DIR}/.venv/bin/python" ]; then
    PYTHON_BIN="${DIR}/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    PYTHON_BIN="python"
fi

if [ -z "$1" ]; then
    echo -e "\033[1m\033[36m📜 KENBUN-HISTORY — Post-Mortem & Memory Search\033[0m"
    echo -e "Usage:"
    echo -e "  bin/kenbun-history \"<query_or_incident>\""
    exit 0
fi

export PYTHONPATH="${DIR}:${DIR}/core:${PYTHONPATH:-}"
export PROJECT_ROOT="${DIR}"

exec "$PYTHON_BIN" -c "
import sys
import json
from tools.specialists.pit_crew import consult_memory_archivist

query = sys.argv[1]

res = json.loads(consult_memory_archivist(query=query))

print(f'\033[1m\033[36m📜 [MEMORY ARCHIVE REPORT]\033[0m Verdict: {res.get(\"verdict\")}')
print('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
recs = res.get('records', [])
if not recs:
    print('ℹ️ No historical post-mortem entries matched this query.')
else:
    for i, r in enumerate(recs, 1):
        print(f'[{i}] Source: {r.get(\"source\")}')
        print(r.get(\"snippet\").strip())
        print('- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -')
print('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
" "$@"
